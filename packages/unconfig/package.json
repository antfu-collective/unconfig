{
  "name": "unconfig",
  "type": "module",
  "version": "7.4.1",
  "packageManager": "pnpm@10.24.0",
  "description": "A universal solution for loading configurations.",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu-collective/unconfig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu-collective/unconfig.git",
    "directory": "packages/unconfig"
  },
  "bugs": {
    "url": "https://github.com/antfu-collective/unconfig/issues"
  },
  "keywords": [
    "config"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./presets": {
      "dev": "./src/presets.ts",
      "default": "./dist/presets.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "*.d.ts",
    "dist"
  ],
  "scripts": {},
  "dependencies": {
    "@quansync/fs": "catalog:prod",
    "defu": "catalog:prod",
    "jiti": "catalog:prod",
    "quansync": "catalog:prod",
    "unconfig-core": "workspace:*"
  },
  "devDependencies": {
    "@antfu/utils": "catalog:"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/presets.ts"
    ]
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./presets": "./dist/presets.mjs",
      "./package.json": "./package.json"
    }
  }
}
